{
  "manifest_version": 3,
  "name": "Insta Downloader",
  "version": "1.1",
  "description": "Download Instagram media directly from your feed.",
  "icons": {
    "128": "image_525fb9.png"
  },
  "action": {
    "default_icon": "image_525fb9.png",
    "default_title": "Insta Downloader"
  },
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://*.instagram.com/*"]
    }
  ]
}